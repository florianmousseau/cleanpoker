{
  "name": "cleanpoker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src/",
    "check:seo": "node scripts/check-seo.mjs",
    "mesure": "node scripts/mesure.mjs",
    "size": "size-limit",
    "gen-og": "node -e \"const {Resvg}=require('@resvg/resvg-js'),fs=require('fs');const r=new Resvg(fs.readFileSync('static/og-image.svg','utf-8'),{width:1200,height:630});fs.writeFileSync('static/og-image.png',r.render().asPng());console.log('done')\"",
    "test": "vitest run",
    "check:reflow": "node scripts/check-reflow.mjs"
  },
  "size-limit": [
    {
      "name": "Entry JS (critical path)",
      "path": ".svelte-kit/cloudflare/_app/immutable/entry/*.js",
      "brotli": true,
      "gzip": false,
      "limit": "15 KB"
    },
    {
      "name": "Shared JS (always loaded)",
      "path": [
        ".svelte-kit/cloudflare/_app/immutable/entry/*.js",
        ".svelte-kit/cloudflare/_app/immutable/chunks/*.js"
      ],
      "brotli": true,
      "gzip": false,
      "limit": "50 KB"
    }
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@size-limit/file": "^13.0.3",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "size-limit": "^13.0.2",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "terser": "^5.50.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "undici": "^7.29.0",
    "cookie": "^0.7.2"
  }
}
